<?xml version="1.0" encoding="utf-8"?>
<!--
    OnboardingSplash — focused 4-step workflow on the empty Detail when no
    folder is picked.

    All FontIcon glyphs use numeric XML escapes so the bytes survive
    encoding pipelines.
-->
<UserControl
    x:Class="FileID.Views.OnboardingSplash"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="60,80">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="24"
                    MaxWidth="560">

            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <!-- Rainbow-shimmering title — 1:1 with macOS Detail.swift:159-178.
                     The LinearGradientBrush's EndPoint is animated by code-behind
                     over 12 s; ReducedMotion freezes it on solid gold. -->
                <TextBlock x:Name="TitleText"
                           Text="Folder Vision"
                           FontSize="56"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level1">
                    <TextBlock.Foreground>
                        <LinearGradientBrush x:Name="TitleBrush"
                                             StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="{StaticResource GoldColor}"    Offset="0.0" />
                            <GradientStop Color="{StaticResource DelightColor}" Offset="0.25" />
                            <GradientStop Color="{StaticResource AiColor}"      Offset="0.5" />
                            <GradientStop Color="{StaticResource InfoColor}"    Offset="0.75" />
                            <GradientStop Color="{StaticResource GoldColor}"    Offset="1.0" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Cari, beri nama, dan rapikan file dengan AI lokal."
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Pick a folder CTA — mirrors macOS Detail.swift:208-219 "Pick a folder"
                 button. Ctrl+O accelerator wired in code-behind. -->
            <Button x:Name="PickFolderButton"
                    HorizontalAlignment="Center"
                    Padding="18,10"
                    CornerRadius="10"
                    Background="{ThemeResource GoldBrush}"
                    Foreground="Black"
                    Click="OnPickFolderClicked"
                    AutomationProperties.Name="Pick a folder"
                    AutomationProperties.HelpText="Choose a library folder to scan (Ctrl+O)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="Black"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="Pick a folder" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <StackPanel Spacing="10">
                <!-- Step 1 — Pick a folder (current next action, gold accent) -->
                <Border Padding="16,14"
                        CornerRadius="12"
                        BorderBrush="{ThemeResource GoldSelectedStrokeBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource GoldSelectedBackgroundBrush}"
                        AutomationProperties.Name="Step 1: Pick a folder. Choose a library on your machine. FileID won't touch the files.">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource GoldBrush}" />
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="1.   Pilih folder utama" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Pilih folder lokal atau OneDrive. File online-only dilewati agar kuota aman."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 2 — automatic index -->
                <Border Padding="16,14"
                        CornerRadius="12"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        AutomationProperties.Name="Step 2: Index automatically. New local files are added to search in the background.">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE773;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="2.   Index otomatis" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Foto dan dokumen baru masuk ke indeks lokal tanpa scan ulang manual."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 3 — contextual search -->
                <Border Padding="16,14"
                        CornerRadius="12"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        AutomationProperties.Name="Step 3: Search by context, visible text, or filename.">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="3.   Cari berdasarkan konteks" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Cari isi foto, teks OCR, judul dokumen, atau nama file dari satu kolom."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 4 — preview mutations -->
                <Border Padding="16,14"
                        CornerRadius="12"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        AutomationProperties.Name="Step 4: Preview rename and organize suggestions before applying changes.">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8AB;" FontSize="20" Foreground="{ThemeResource AiBrush}" />
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="4.   Preview rename &amp; organize" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="AI memberi usulan. Hanya file yang kamu checklist dan konfirmasi yang berubah."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
